# Postgres connection
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=peercast
PG_PASSWORD=peers123
PG_DB=peercastdb
PG_SSLMODE=disable    # disable | require | verify-full etc.

# Pool / tuning
PG_MAX_CONNS=10
PG_MIN_CONNS=1
PG_CONN_MAX_LIFETIME=30m
PG_CONN_MAX_IDLE_TIME=5m


